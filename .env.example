# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Do not put real values in this file: it is committed to git.

# Public URL of this app, used to build the OAuth callback URL.
APP_URL=http://localhost:3000

# GitHub OAuth App (https://github.com/settings/developers -> OAuth Apps -> New OAuth App)
# Homepage URL:               http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# PostgreSQL connection string (Neon: Dashboard -> Connect -> connection string).
DATABASE_URL=

# Secret used to encrypt the session cookie. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
